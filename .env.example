# ---- Frontend (aman dipublikasikan; masuk ke bundle) ----
# true  = pakai AI tiruan (tanpa jaringan, tanpa key). Cocok untuk `npm run dev`.
# false = panggil proxy /api/gemini (jalankan lewat `npx netlify-cli dev`).
VITE_USE_MOCK_AI=true

# ---- Server only (JANGAN diawali VITE_; jangan di-commit) ----
# Salin file ini menjadi .env untuk `netlify dev`. Di produksi, isi di
# Netlify > Project configuration > Environment variables.
# Dapatkan key baru di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Opsional: origin tambahan yang boleh memanggil proxy (pisahkan koma)
# ALLOWED_ORIGINS=https://contoh.netlify.app
